# ==============================================================================
# CareerOS Frontend Environment Configuration
# ==============================================================================

# URL of your deployed backend API (e.g. Render, Railway, VPS)
# When developing locally, set to: http://localhost:8000
VITE_API_URL=http://localhost:8000

# (Optional) Supabase Authentication
# If omitted or left empty, CareerOS will automatically enable local/guest mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=