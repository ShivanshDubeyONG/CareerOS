# ==============================================================================
# CareerOS Master Environment Configuration
# ==============================================================================
# Copy this file to .env for local development, or copy the respective
# variables to your hosting platforms (e.g. Render for Backend, Vercel for Frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (e.g. Render / Railway / Docker)
# ------------------------------------------------------------------------------

# Frontend URLs allowed to communicate with this backend (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Google Gemini API Key (Recommended for AI deep analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# GitHub Personal Access Token (Optional)
# Increases API rate limits from 60 req/hr to 5,000 req/hr.
# Generate one at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# Apify API Token (Optional - for LinkedIn profile extraction)
# Get a free token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Optional secondary scrapers
SCRAPINGDOG_API_KEY=
BRIGHTDATA_API_KEY=

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (e.g. Vercel / Netlify / Cloudflare Pages)
# Note: Vite requires environment variables exposed to the browser to begin with VITE_
# ------------------------------------------------------------------------------

# The public URL of your deployed backend API (no trailing slash)
# Local: http://localhost:8000
# Production: https://your-careeros-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Authentication (Optional)
# If omitted or left blank, CareerOS runs seamlessly in guest/local mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
