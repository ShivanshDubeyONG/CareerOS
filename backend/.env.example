# ==============================================================================
# CareerOS Environment Configuration Example
# Copy this file to .env and fill in your keys.
# ==============================================================================

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API Key (Required for AI insights; fallback heuristics used if missing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# GitHub API Token (Optional - unauthenticated rate limit allows up to 60 req/hr)
GITHUB_TOKEN=

# Apify API Token (Optional - for LinkedIn profile extraction)
APIFY_API_TOKEN=

# Optional secondary scrapers
SCRAPINGDOG_API_KEY=
BRIGHTDATA_API_KEY=
